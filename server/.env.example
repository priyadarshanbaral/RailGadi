# Copy this file to server/.env and replace every placeholder.

# MongoDB is required for persistent accounts in production.
MONGODB_URI=mongodb://127.0.0.1:27017/railgaadi

# Generate a unique random secret (at least 32 characters). Server-only.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Twilio Console > Account Info > Account SID and Auth Token
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token

# Twilio Console > Verify > Services > your service > Service SID
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of the frontend
FRONTEND_URL=http://localhost:3000
# Optional comma-separated list of production frontend origins.
CORS_ORIGINS=

# Set to the number of trusted proxies in front of the backend if the host
# requires it for accurate client IP-based request limits.
# TRUST_PROXY_HOPS=1

# Set production in the hosting platform; not needed for local development.
# NODE_ENV=production
