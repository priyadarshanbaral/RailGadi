# ────────────────────────────────────────────────────────────────────────────
# RailGaadi — Server Environment Variables
#
# Copy this file to .env (in the /server folder) and fill in your values.
#   Copy with:  cp server/.env.example server/.env   (or rename on Windows)
#
# The Registration Confirmation email uses these Gmail SMTP credentials.
# ────────────────────────────────────────────────────────────────────────────

# Main MongoDB connection string (optional — falls back to localhost)
# MONGODB_URI=mongodb://127.0.0.1:27017/railgaadi

# Gmail address that SENDS the confirmation emails (MUST be a real address)
EMAIL_USER=youremail@gmail.com

# Gmail App Password (NOT your normal Gmail password).
# ⚠️  A real Gmail App Password is EXACTLY 16 characters (letters + spaces).
#     If your value is a different length, Gmail will reject it and NO email
#     will be sent. Generate one at:
#     https://myaccount.google.com/apppasswords  (after enabling 2-Step Verification)
EMAIL_PASS=your-16-char-app-password

# Public URL of the frontend (used in the Login button/links)
FRONTEND_URL=http://localhost:3000

# Support / contact email shown in the email footer
SUPPORT_EMAIL=support@railgaadi.com
